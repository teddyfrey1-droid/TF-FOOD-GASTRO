# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Exception : ne contient que l'URL et la clé publique du projet Supabase,
# qui sont de toute façon visibles dans le navigateur. Aucun secret ici.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local
supabase/.temp/
supabase/.branches/

# Données métier confidentielles (CA, calculateur) — jamais versionnées
data/*.csv
!data/*.example.csv
